{
  "manifest_version": 3,
  "name": "ClipB Router",
  "version": "0.1.0",
  "description": "Moves a tab to the Chrome profile your ClipB rules pick.",
  "key": "",
  "permissions": ["nativeMessaging", "identity", "identity.email", "webNavigation", "tabs", "storage"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "ClipB Router", "default_popup": "popup.html" }
}
